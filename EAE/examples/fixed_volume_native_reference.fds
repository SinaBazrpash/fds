&HEAD CHID='case', TITLE='Isolated physical-cell EAE HT3D' /
&MESH IJK=6,6,6, XB=0,.6,0,.6,0,.6 /
&TIME T_END=0.03, DT=0.000125, WALL_INCREMENT=1, LOCK_TIME_STEP=.TRUE., DT_END_FILL=0 /
&MISC TMPA=326.85, RADIATION=.FALSE., Y_CO2_INFTY=0 /
&DUMP SIG_FIGS=14, DT_DEVC=0.000125, DT_RESTART=0.03, MASS_FILE=T /
&SPEC ID='CARBON DIOXIDE' /
&MATL ID='RESIDUE', DENSITY=500, CONDUCTIVITY=0.2, SPECIFIC_HEAT=1, ALLOW_SHRINKING=F, ALLOW_SWELLING=F, ADJUST_H=F /
&MATL ID='VIRGIN', DENSITY=500, CONDUCTIVITY=0.2, SPECIFIC_HEAT=1,
 EAE_A=1000000.0, EAE_K=2, EAE_N=1, EAE_NODES=32, EAE_EMIN=40, EAE_EMAX=120, EAE_MU=70,90, EAE_SIGMA=6,8, EAE_PI=.4,.6, MATL_ID='RESIDUE', NU_MATL=0.19999999999999996, SPEC_ID='CARBON DIOXIDE', NU_SPEC=0.8, HEAT_OF_REACTION=0.0, ALLOW_SHRINKING=F, ALLOW_SWELLING=F, ADJUST_H=F /
&SURF ID='CHUNK', HT3D=T, EAE_HT3D=.TRUE., MATL_ID='VIRGIN', CELL_SIZE=.1,
 TMP_INNER=326.85, BACKING='EXPOSED', LAYER_DIVIDE=-1, HEAT_TRANSFER_COEFFICIENT=0,
 HEAT_TRANSFER_COEFFICIENT_BACK=0, EMISSIVITY=0, MINIMUM_LAYER_MASS_FRACTION=0, MINIMUM_LAYER_THICKNESS=0,
 HT3D_WEIGHT=0.3333333333333333,0.3333333333333333,0.3333333333333333 /
&OBST XB=.2,0.4,.2,0.4,.2,0.4, SURF_ID='CHUNK', MATL_ID='VIRGIN' /
&DEVC ID='gas', XB=0,.6,0,.6,0,.6, QUANTITY='DENSITY', SPEC_ID='CARBON DIOXIDE', SPATIAL_STATISTIC='VOLUME INTEGRAL', TIME_AVERAGED=F /
&DEVC ID='emission', XB=.199,0.401,.199,0.401,.199,0.401, SURF_ID='CHUNK', QUANTITY='MASS FLUX', SPEC_ID='CARBON DIOXIDE', SPATIAL_STATISTIC='SURFACE INTEGRAL', TEMPORAL_STATISTIC='TIME INTEGRAL' /
&DEVC ID='Ts', XYZ=.25,.25,.25, QUANTITY='TEMPERATURE', TIME_AVERAGED=F /
&TAIL /
