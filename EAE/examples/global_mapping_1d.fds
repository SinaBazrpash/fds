&HEAD CHID='global_mapping_1d', TITLE='Illustrative Gaussian output mapping; not fitted material data' /
&MESH IJK=3,1,4, XB=-2,2,-.5,.5,0,1 /
&MISC TMPA=30., TGA_FINAL_TEMPERATURE=750., TGA_DT=.05, TGA_DUMP=1.,
      EAE_TGA_PRESCRIBED=.TRUE., EAE_TGA_LINEAR=.TRUE. /
&TIME T_END=4320. /
&SPEC ID='CARBON DIOXIDE' /
&VENT XB=-1,1,-.5,.5,0,0, SURF_ID='SAMPLE' /
&SURF ID='SAMPLE', TGA_ANALYSIS=.TRUE., TGA_HEATING_RATE=10.,
      THICKNESS=.02, MATL_ID='DEMO' /
&MATL ID='DEMO', DENSITY=500., CONDUCTIVITY=.2, SPECIFIC_HEAT=1.,
      N_REACTIONS=1, HEAT_OF_REACTION=0.,
      EAE_A=1.E12, EAE_K=2, EAE_N=1, EAE_NODES=180,
      EAE_EMIN=50., EAE_EMAX=450.,
      EAE_MU=150.,200., EAE_SIGMA=15.,20., EAE_PI=.4,.6,
      SPEC_ID='CARBON DIOXIDE', NU_SPEC=.8,
      MATL_ID='INERT_RESIDUE', NU_MATL=.2 /
&MATL ID='INERT_RESIDUE', DENSITY=500., CONDUCTIVITY=.2, SPECIFIC_HEAT=1. /
&TAIL /
